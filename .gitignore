# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Claude Code personal settings (permissions, etc.)
.claude/settings.local.json

# Django staticfiles collectstatic output (web/manage.py collectstatic)
web/staticfiles/*
!web/staticfiles/.gitkeep

# Node deps for web/'s Vitest suite (web/package.json), plus any stray
# node_modules/Vite cache the IDE's test runner drops elsewhere in the tree.
node_modules/
.vite/

# Playwright MCP session artifacts (screenshots/snapshots from manual verification)
.playwright-mcp/
