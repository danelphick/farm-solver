# Keep the build context to what the image actually runs: the solver modules,
# their data files, and web/. Everything below is either dev-only, rebuilt
# inside the image, or player data that must never ship in a public container.

.git
.gitignore

# Rebuilt by the Dockerfile's `uv sync` -- and a macOS/arm64 venv would be
# useless in a linux image anyway.
.venv
__pycache__
**/__pycache__
*.pyc

# dan's own FarmRPG mastery/inventory snapshots. The web app never reads these
# (webapi._prepare builds the GameState from the request's pasted text, not
# from solver.data_directory), and they are personal data.
mydata

# Dev tooling and caches.
.claude
.playwright-mcp
.pytest_cache
.ruff_cache
tests
scripts
plans

# JS deps are dev-only: web/solverapp/static/ is vanilla JS with no build step,
# and node_modules exists purely for Vitest.
node_modules
web/node_modules
web/package.json
web/package-lock.json
web/vitest.config.js
**/*.test.js
web/solverapp/static/solverapp/template-fixture.js

# Regenerated by `collectstatic` during the build.
web/staticfiles

# Docs are never read at runtime, only referenced in comments -- but keep
# README.md, which pyproject.toml's `readme` field points at.
*.md
!README.md

# Local env files, in case any appear later.
.env
.env.*
